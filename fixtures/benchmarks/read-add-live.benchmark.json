{
  "id": "read-add-live",
  "name": "Live read task (DeepSeek)",
  "description": "Read Add.java with real LLM.",
  "live": true,
  "workspace": "fixtures/repos/sample-lib",
  "model": "deepseek:deepseek-chat",
